# Copy to .env and fill in. Never commit .env.

# Required. NWS requires a User-Agent that identifies the app; include a contact
# (website or email) so NWS can reach you. Source: weather.gov API docs,
# .claude/skills/nws-api-docs/references/verbatim/services-web-api.md
WEATHERBOT_USER_AGENT="weatherbot (your-email@example.com)"

# Optional overrides. Defaults are in weatherbot/config.py with the reason for each.
# WEATHERBOT_HTTP_TIMEOUT_S=20
# WEATHERBOT_HTTP_RETRIES=3
# WEATHERBOT_HTTP_BACKOFF_S=2
# WEATHERBOT_MAX_OBS_AGE_MIN=90
# WEATHERBOT_MAX_BOOK_AGE_S=120
# WEATHERBOT_MAX_FORECAST_RUN_AGE_H=18
